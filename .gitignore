# Secrets — never commit. Contains live Gemini API keys.
.env

# OS junk
.DS_Store

# Python
__pycache__/
*.pyc

# Dataset generation: regeneratable response cache and local run state.
# The finished train/dev sets, generation_report.md, and rejected.jsonl are NOT excluded —
# those are the deliverables. The cache is ~2000 raw API responses kept only so an interrupted
# run can resume without re-spending quota; it has no value once a run has finished.
turkish-retrieval-model-selection/data_morph_v2/_cache/
turkish-retrieval-model-selection/data_morph_v2/_usage.json
turkish-retrieval-model-selection/data_morph_v2/run_v*.log

# Stray manual duplicates (e.g. Finder "... copy" files)
turkish-retrieval-model-selection/data_morph_v2/*copy*
